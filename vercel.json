{
  "version": 2,
  "builds": [
    { "src": "api/webhook.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "api/webhook.py" },
    { "src": "/api/cron", "dest": "api/webhook.py" },
    { "src": "/api/pollform", "dest": "api/webhook.py" },
    { "src": "/api/pollformdata", "dest": "api/webhook.py" },
    { "src": "/api/submitpoll", "dest": "api/webhook.py" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 8 * * *" }
  ]
}
